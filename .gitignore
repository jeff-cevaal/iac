# local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# crash log files
crash.log
crash.*.log

# tfvars files
*.tfvars
*.trvars.json

# ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# ignore cli config files
.terraformrc
terraform.rc
